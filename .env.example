# =============================================
# MindMirror - No API keys required!
# All AI runs locally via Docker
# =============================================

# Ollama (local LLM - auto configured by Docker)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Whisper model size: tiny | base | small
# tiny = fastest on CPU, base = recommended
WHISPER_MODEL=base

# PostgreSQL (auto configured by Docker)
DATABASE_URL=postgresql://mindmirror_user:mindmirror_pass@postgres:5432/mindmirror

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth secret - change this to a random string
JWT_SECRET=change_this_to_random_string

# HuggingFace cache (models download once, cached in Docker volume)
HF_HOME=/app/.cache/huggingface

# ===========================================
# DEPLOYMENT MODE (Render / Cloud)
# ===========================================
# Change AI_PROVIDER to "groq" for cloud deployment
# Get free Groq API key at: https://console.groq.com
# No credit card required - free tier available

AI_PROVIDER=ollama
GROQ_API_KEY=GROQ_API_KEY

# For local dev leave AI_PROVIDER=ollama and ignore GROQ_API_KEY
